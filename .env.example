# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI credentials and model (placeholder only - do not put a real key here)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# SQLite persistent memory
DATABASE_URL=sqlite:///./lesson_memory.db

# Workflow behaviour: regeneration retries, must be 0-2
MAX_RETRIES=2

# Application: APP_ENV is one of development, testing, production
APP_ENV=development
DEBUG=false
