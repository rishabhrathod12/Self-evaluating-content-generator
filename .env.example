# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI credentials and model (placeholder only - do not put a real key here)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# SQLite persistent memory
DATABASE_URL=sqlite:///./lesson_memory.db

# Workflow behaviour
MAX_REGENERATION_RETRIES=2

# Application
APP_ENV=development
LOG_LEVEL=INFO
OUTPUT_DIR=outputs
